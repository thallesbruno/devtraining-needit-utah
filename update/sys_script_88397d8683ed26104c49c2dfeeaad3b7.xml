        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var agora = new GlideDateTime();

    var quandoPrecisar = new GlideDateTime(current.u_when_needed);

	//executando gs
	gs.info('Executando gs.info');
	gs.warn('Executando gs.warn');
	gs.error('Executando gs.error');
	gs.debug('Executando gs.debug');

	if (quandoPrecisar.getDate() == agora.getDate()) {
        gs.addErrorMessage("'Quando preciso' deve ter pelo menos 1 dia de prazo para execução, sua requisição não foi gravada.");
        current.setAbortAction(true);
    } else if (quandoPrecisar.before(agora)) {
        gs.addErrorMessage("'Quando preciso' não pode ser no passado, sua requisição não foi gravada.");
        current.setAbortAction(true);
    }

})(current, previous);]]></script>
